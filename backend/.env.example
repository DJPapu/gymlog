# Copia como .env y rellena los valores reales

# PostgreSQL de Supabase — usa el Session Pooler (puerto 5432)
# Supabase > Settings > Database > Connection string > Session pooler
DATABASE_URL=postgresql+psycopg://postgres.XXXX:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Token estático que el frontend envía como Bearer; elige una cadena larga y aleatoria
API_SECRET=cambia-esto-por-una-cadena-secreta-larga

# user_id fijo que se almacena en todas las tablas (cualquier string, p.ej. tu nombre o un UUID)
FIXED_USER_ID=valentin

# Orígenes CORS separados por comas
CORS_ORIGINS=http://localhost:5173,https://TU-PROYECTO.pages.dev

# Gemini API (para resumen de progreso en el Admin) — obtener gratis en aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
